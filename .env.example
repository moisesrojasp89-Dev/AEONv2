# ─────────────────────────────────────────────────────────────
# AEON — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# Supabase (public — safe for browser with RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# TwelveData — DO NOT use VITE_ prefix (backend use only via Edge Function)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# OANDA — backend only, used by supabase/functions/oanda Edge Function
OANDA_TOKEN=your_oanda_token_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here

# Supabase Service Role Key — ONLY for server-side scripts, NEVER in frontend
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
